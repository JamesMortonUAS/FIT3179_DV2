{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans, sans-serif",
    "axis": {
      "labelColor": "#d2dddf",
      "titleColor": "#d2dddf",
      "gridColor": "#304449",
      "labelFontSize": 11
    },
    "legend": {
      "labelColor": "#d2dddf",
      "titleColor": "#d2dddf"
    }
  },
  "width": "container",
  "height": 375,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 510
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME",
      "as": "stateName"
    },
    {
      "lookup": "stateName",
      "from": {
        "data": {
          "url": "data/state-2025.json"
        },
        "key": "state",
        "fields": [
          "share",
          "total_gwh"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#152e34",
    "strokeWidth": 1.5
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "datum.share >= 50",
        "value": "#80d5a8"
      },
      "value": "#34454a"
    },
    "tooltip": [
      {
        "field": "stateName",
        "title": "State"
      },
      {
        "field": "share",
        "title": "Renewables (%)",
        "format": ".1f"
      }
    ]
  },
  "description": "Australia-centred Mercator categorical map showing whether each state reached 50% renewable generation in 2025."
}
