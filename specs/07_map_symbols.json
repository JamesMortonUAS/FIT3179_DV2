{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans, sans-serif",
    "axis": {
      "labelColor": "#d2dddf",
      "titleColor": "#d2dddf",
      "gridColor": "#304449",
      "labelFontSize": 11
    },
    "legend": {
      "labelColor": "#d2dddf",
      "titleColor": "#d2dddf"
    }
  },
  "width": "container",
  "height": 375,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 510
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#294045",
        "stroke": "#718582",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state-series.json"
      },
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#edb66d",
        "opacity": 0.8,
        "stroke": "#fff3dc",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "size": {
          "field": "total_gwh",
          "type": "quantitative",
          "scale": {
            "range": [
              70,
              2200
            ]
          },
          "title": "Generation (GWh)"
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "total_gwh",
            "title": "Generation (GWh)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "description": "Australia-centred Mercator proportional-symbol map of total state electricity generation in 2025."
}
