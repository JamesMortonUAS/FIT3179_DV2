{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans, sans-serif",
    "axis": {
      "labelColor": "#d2dddf",
      "titleColor": "#d2dddf",
      "gridColor": "#304449",
      "labelFontSize": 11
    },
    "legend": {
      "labelColor": "#d2dddf",
      "titleColor": "#d2dddf"
    }
  },
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/state-series.json"
  },
  "mark": {
    "type": "rect",
    "stroke": "#13272c",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null
    },
    "y": {
      "field": "region",
      "type": "nominal",
      "title": null,
      "sort": [
        "TAS",
        "SA",
        "VIC",
        "NSW",
        "QLD",
        "WA",
        "NT"
      ]
    },
    "color": {
      "field": "share",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ],
        "range": [
          "#274048",
          "#80d5a8"
        ]
      },
      "title": "Renewables (%)"
    },
    "tooltip": [
      {
        "field": "state"
      },
      {
        "field": "year"
      },
      {
        "field": "share",
        "title": "Renewables (%)",
        "format": ".1f"
      }
    ]
  }
}